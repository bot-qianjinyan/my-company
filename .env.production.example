# =============================================
# 生产环境部署配置模板
# 使用方法：复制为 .env 并修改其中的密码/密钥
#   cp .env.production.example .env
# docker compose 会自动读取同目录下的 .env 文件
# =============================================

# ---- PostgreSQL 数据库 ----
POSTGRES_USER=mycompany
POSTGRES_PASSWORD=please-change-to-a-strong-password
POSTGRES_DB=mycompany_db

# ---- 后端安全配置 ----
# 务必修改为随机字符串，例如执行: openssl rand -hex 32
SECRET_KEY=please-change-this-to-a-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# 允许访问后端接口的前端来源（一般同域部署下可不使用，保留以兼容跨域场景）
CORS_ORIGINS=http://your-domain.com,https://your-domain.com

# 首次部署建议设为 true，之后可改回 false
AUTO_SEED=true

# ---- 前端对外端口 ----
# 如果服务器上 80 端口已被占用（例如已有 nginx/宝塔面板），可改成其他端口，再通过外层反代转发
FRONTEND_PORT=80
