# 应用配置
APP_NAME=My Company Platform
APP_ENV=development
DEBUG=true

# 数据库配置（本地开发用 PostgreSQL，端口 5433 见 README 说明）
DATABASE_URL=postgresql+psycopg://mycompany:mycompany123@127.0.0.1:5433/mycompany_db

# JWT 配置
SECRET_KEY=please-change-this-to-a-random-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
